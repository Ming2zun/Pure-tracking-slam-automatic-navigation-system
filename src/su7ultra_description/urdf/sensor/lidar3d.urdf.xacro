<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="lidar3d_xacro" params="parent_link xyz">
        <link name="lidar3d_link">
        </link>

        <joint name="lidar3d_fixed_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="lidar3d_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>

        <gazebo reference="lidar3d_link">
            <sensor type="ray" name="lidar3d">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <visualize>false</visualize>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-1.3962634</min_angle>
                            <max_angle>1.3962634</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>32</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.261799</min_angle>
                            <max_angle>0.261799</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.3</min>
                        <max>100.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.02</stddev>
                    </noise>
                </ray>
                <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/vehicle</namespace>
                        <remapping>~/out:=/points_raw</remapping>
                    </ros>
                    <output_type>sensor_msgs/PointCloud2</output_type>
                    <frame_name>lidar3d_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>